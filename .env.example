# Local-only defaults. Configure hosted values with the hosting provider's secret settings.
APP_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=
# Stripe prices, one per length sold. Each must be a recurring price whose
# interval matches the length it is filed under - monthly, 3-monthly, yearly - and
# the checkout route refuses a mismatch rather than selling the wrong one. At
# least one is required for payments; any that is left blank is not offered.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Full free-account access, counted from account creation. Set to 0 to disable.
FREE_TRIAL_DAYS=7

# Number of words available for free after the full-access trial. Set to 0 to disable.
# The default is 224, the easiest bands of the collection.
FREE_WORD_LIMIT=224

# Password recovery email. Without these a parent can ask for a reset link and
# the request succeeds while nothing is sent; the server logs a warning once per
# Worker instance and the parent waits for a message that cannot arrive.
#
# `npm run dev:node` ignores this key on purpose, so that a local signup or a
# test suite cannot post through the production Resend account. To send real
# mail from local development, run `MINEWORDS_DEV_MAIL=1 npm run dev:node`.
RESEND_API_KEY=
# Verified sender, e.g. MineWords <no-reply@yourdomain>
EMAIL_FROM=

# Cloudflare Turnstile, the human check in front of contact, registration and
# password reset. Create a widget in the Cloudflare dashboard (Turnstile → Add
# widget) and put both keys here. Leave both empty to switch the check off, which
# is what a local checkout and the test suite rely on: with no keys, the forms
# work exactly as before and nothing is rendered. Setting only one leaves it off
# too. Deployed, both are `wrangler secret put` values, not build-time ones.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Maintenance-only pronunciation generation. Never exposed to the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
