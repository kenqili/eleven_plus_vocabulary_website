# Local-only defaults. Configure hosted values with the hosting provider's secret settings.
APP_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=
# Stripe prices, one per length sold. Each must be a recurring price whose
# interval matches the length it is filed under - monthly, 3-monthly, yearly - and
# the checkout route refuses a mismatch rather than selling the wrong one. At
# least one is required for payments; any that is left blank is not offered.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Full free-account access, counted from account creation. Set to 0 to disable.
FREE_TRIAL_DAYS=7

# Number of words available for free after the full-access trial. Set to 0 to disable.
FREE_WORD_LIMIT=20

# Password recovery email. Without these a parent can ask for a reset link and
# the request succeeds while nothing is sent; the server logs a warning once per
# Worker instance and the parent waits for a message that cannot arrive.
RESEND_API_KEY=
# Verified sender, e.g. MineWords <no-reply@yourdomain>
EMAIL_FROM=

# Maintenance-only pronunciation generation. Never exposed to the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
