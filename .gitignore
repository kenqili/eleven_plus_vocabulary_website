# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
*.tsbuildinfo

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/.idea/
/outputs/
/work/

# Pronunciation and story audio are committed, not ignored: they are generated
# once and then ride along with every build, so a build from a clean clone has
# the same clips the developer has. Refresh them with `npm run audio:generate`
# and `npm run audio:stories:generate`, and check with the matching
# `audio:validate` scripts, which exit non-zero when a clip is missing or no
# longer matches the words it was made from.

# local tool state used to regenerate data snapshots; never publish them.
# Node >=22.13 to load the TypeScript sources, and wordfreq==3.1.1 for
# scripts/generate-word-levels.py. See data/word-levels/README.md.
/.tools/
/.venv-wordfreq/

# The browser's copy of the question bank, content-hashed and rebuilt by
# scripts/generate-client-bank.mjs on every build. Generated, never edited.
# The committed audio beside it is the opposite case and is deliberately tracked.
public/bank/
