# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
*.tsbuildinfo

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/.idea/
/outputs/
/work/

# generated pronunciation and story audio; rebuild with `npm run audio:generate`
# and `npm run audio:stories:generate`
/public/audio/

# local tool state used to regenerate data snapshots; never publish them.
# Node >=22.13 to load the TypeScript sources, and wordfreq==3.1.1 for
# scripts/generate-word-levels.py. See data/word-levels/README.md.
/.tools/
/.venv-wordfreq/
